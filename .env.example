# Groq API
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# PostgreSQL audit trail
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/truvanai

# Redis HITL queue
REDIS_URL=redis://localhost:6379/0

# Gmail SMTP alerts (use a Google App Password, not your account password)
GMAIL_SENDER=
GMAIL_APP_PASSWORD=
GMAIL_RECIPIENT=

# Demo controls
SIMULATE_VIOLATION=true

# Server
PORT=8000
